# ─────────────────────────────────────────────────────────────
# Entropy — environment template.  Copy to .env and fill in.
#   cp .env.example .env
# NEVER commit .env — keys belong in your local env only.
# ─────────────────────────────────────────────────────────────

# SQLite (Prisma)
DATABASE_URL=file:./db/custom.db

# ── LLM provider chain ──────────────────────────────────────
# Primary — Experiential Labs gateway (300+ models behind one key)
# https://platform.experientiallabs.ai → Settings → API keys
EXPLABS_API_BASE=https://api.experientiallabs.ai/v1
EXPLABS_API_KEY=
# models tried in order (batch-only slugs are skipped automatically)
EXPLABS_MODELS=gpt-oss-120b-batch,minimax-m2.7-free,kimi-k2.6,glm-5.2,qwen3.6-flash

# OpenRouter — free chain (:free models cost $0 on any key)
# https://openrouter.ai → Keys
OPENROUTER_API_KEY=

# NVIDIA NIM — thinking models
# https://build.nvidia.com → Get API Key
NVIDIA_API_KEY=

# Groq — last-resort fallback
# https://console.groq.com → API Keys
GROQ_API_KEY=

# Provider waterfall order (groq last by design)
PROVIDER_DEFAULT_ORDER=explabs,openrouter,freechain,nvidia,ollama,glm,gemini,openai,zai,groq

# Force one provider while debugging (e.g. explabs | groq | openrouter)
AGENT_LLM_PROVIDER=

# ── Agent tuning (optional) ─────────────────────────────────
AGENT_MAX_STEPS=12
AGENT_RATE_PER_MIN=1
AGENT_AUTOPILOT=0
AGENT_MCP=1
REMOTE_PYTHON_LIMIT=10
REMOTE_PYTHON_AI=1

# ── Local inference (optional — Ollama) ─────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder

# ── Live preview ports strip (optional) ─────────────────────
PREVIEW_PORTS=3000,8787,4597,5000,8000,5173,4321

# ── MCP servers (optional) ──────────────────────────────────
# classic PAT with repo scope enables the GitHub MCP server
GITHUB_PERSONAL_ACCESS_TOKEN=
