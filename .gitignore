.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (template is committed; real .env never)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# ── Entropy repo hygiene: sandbox-only artifacts never pushed ──
# runtime data (SQLite lives here on the dev box)
/db/
# packaged copies & distributions
/dist/
/download/
# third-party reference repos (private study material)
/reference/
# raw tool output logs
/tool-results/
# uploads & sandbox scaffolding
/upload/
/skills/
/.zscripts/
/Caddyfile
/tests/
/examples/
# verification artifacts (screenshots, VLM dumps, scrapes)
/scripts/*.png
/scripts/*.jpg
/scripts/*.jpeg
/scripts/*.webm
/scripts/*.pdf
/scripts/*.json
/scripts/*.txt
/scripts/naukri_*.json
# probe scripts with embedded credentials — keys belong in .env only
/scripts/explabs-probe*.mjs
/scripts/probe-*.mjs
/scripts/probe-*.ts
# workspace binaries
*.pkl
__pycache__/
